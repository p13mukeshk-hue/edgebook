# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim
WORKDIR /app/migration

COPY migration/package.json migration/package-lock.json ./
RUN npm ci --omit=dev
COPY migration/ ./

RUN groupadd --gid 12001 edgebook \
    && useradd --uid 12001 --gid 12001 --home-dir /nonexistent \
       --shell /usr/sbin/nologin edgebook \
    && chown -R edgebook:edgebook /app/migration

USER 12001:12001
ENTRYPOINT ["node"]
CMD ["--help"]
