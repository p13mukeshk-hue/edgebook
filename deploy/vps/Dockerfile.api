# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS build
WORKDIR /build/server

# Dependency layers stay isolated from the host's Node.js installation.
COPY server/package.json server/package-lock.json ./
RUN npm ci

COPY server/ ./
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production

RUN groupadd --gid 12001 edgebook \
    && useradd --uid 12001 --gid 12001 --home-dir /nonexistent \
       --shell /usr/sbin/nologin edgebook

WORKDIR /app/server
COPY --from=build --chown=edgebook:edgebook /build/server/package.json ./
COPY --from=build --chown=edgebook:edgebook /build/server/node_modules ./node_modules
COPY --from=build --chown=edgebook:edgebook /build/server/dist ./dist
COPY --from=build --chown=edgebook:edgebook /build/server/migrations ./migrations

USER 12001:12001
EXPOSE 3210
CMD ["node", "dist/main.js"]
