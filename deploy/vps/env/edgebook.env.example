# Copy to /etc/edgebook/edgebook.env on the VPS and chmod 0600.
# Values below are deliberately blank or non-secret defaults. Never commit the
# populated file. Generate a unique password/secret for every blank secret.

EDGEBOOK_IMAGE_TAG=
EDGEBOOK_HOST_PORT=3210
EDGEBOOK_MIN_FREE_BYTES=10737418240
EDGEBOOK_WARN_FREE_BYTES=16106127360
# Blank during rehearsal. At the final single-writer handoff set this to
# `writer` together with SCHEDULER_ENABLED=true, then restart the stack.
COMPOSE_PROFILES=

# Dedicated PostgreSQL container. It has no host port.
POSTGRES_DB=edgebook
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
EDGEBOOK_DB_OWNER=edgebook_owner
EDGEBOOK_DB_OWNER_PASSWORD=
EDGEBOOK_APP_USER=edgebook_app
EDGEBOOK_APP_PASSWORD=
# Both URLs must use the private Compose hostname `postgres`, never localhost,
# 127.0.0.1, the host PostgreSQL instance, or a published port. URL-encode the
# generated password before embedding it.
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Web/session configuration.
PUBLIC_ORIGIN=https://edgebook.trade
TRUST_PROXY=true
GOOGLE_CLIENT_ID=
SESSION_PEPPER=
SESSION_TTL_DAYS=14
SESSION_IDLE_MINUTES=1440
COOKIE_SECURE=true
DB_POOL_MAX=10

# Official OAuth remains the preferred cTrader connection and requests the
# provider-enforced read-only `scope=accounts`. The optional MCP compatibility
# connector accepts a per-account Remote MCP configuration in the authenticated
# dashboard, never in this environment file. It is session-bound and Edgebook
# hard-allows read calls only, although the provider token itself can trade.
# Leave OAuth credentials blank when using MCP compatibility alone.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
# At activation, set the canonical callback to:
# https://edgebook.trade/api/auth/ctrader/callback
CTRADER_REDIRECT_URI=
# Explicit opt-in for the in-dashboard Remote MCP compatibility connector.
CTRADER_MCP_ENABLED=false
# JSON keyring; each value is one fresh 32-byte base64url key. The populated
# systemd EnvironmentFile value must be single-quoted as one whole value so its
# inner JSON quotes survive both systemd and Compose parsing, for example:
# CTRADER_ENCRYPTION_KEYS='{"1":"<43-character-base64url-key>"}'
CTRADER_ENCRYPTION_KEYS=
CTRADER_ACTIVE_KEY_VERSION=
CTRADER_OAUTH_STATE_TTL_SECONDS=300
CTRADER_GRANT_TTL_SECONDS=600
CTRADER_REQUEST_TIMEOUT_MS=15000
CTRADER_SYNC_INTERVAL_SECONDS=300
CTRADER_STALE_AFTER_SECONDS=900
CTRADER_SYNC_OVERLAP_SECONDS=300
# Optional reviewed earliest timestamp in Unix milliseconds; blank uses the
# authoritative cTrader account registration timestamp.
CTRADER_HISTORY_START_TIMESTAMP=
CTRADER_REFRESH_SKEW_SECONDS=300
CTRADER_MAX_DEALS_PER_REQUEST=1000
CTRADER_SYMBOL_CACHE_SECONDS=86400
CTRADER_TRADING_TIME_ZONE=Asia/Kolkata
WORKER_DB_POOL_MAX=4

# Private upload policy.
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=40000000
USER_STORAGE_QUOTA_BYTES=524288000
TOTAL_STORAGE_QUOTA_BYTES=10737418240
MIN_DISK_FREE_BYTES=10737418240
SSE_HEARTBEAT_MS=20000

# Keep false and COMPOSE_PROFILES blank until Firebase schedules/writes are
# disabled and the single-writer cutover gate is signed off. The worker also
# enforces PostgreSQL advisory locks.
SCHEDULER_ENABLED=false

# Logging: do not log tokens, cookies, authorization headers, image bodies, or
# database URLs.
LOG_LEVEL=info
