# Non-secret CI/validation fixture. This file is never a deployable environment.
# It proves that the default, profile-free Compose model renders with cTrader
# disabled and with the inactive migrator URL blank.
EDGEBOOK_IMAGE_TAG=fixture
COMPOSE_PROFILES=
POSTGRES_DB=edgebook_fixture
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=fixture-superuser-password
EDGEBOOK_DB_OWNER=edgebook_owner
EDGEBOOK_DB_OWNER_PASSWORD=fixture-owner-password
EDGEBOOK_APP_USER=edgebook_app
EDGEBOOK_APP_PASSWORD=fixture-app-password
DATABASE_URL=postgresql://edgebook_app:fixture-app-password@postgres:5432/edgebook_fixture
MIGRATION_DATABASE_URL=
PUBLIC_ORIGIN=https://edgebook.trade
GOOGLE_CLIENT_ID=fixture.apps.googleusercontent.com
SESSION_PEPPER=fixture-session-pepper-not-for-production
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=
CTRADER_ENCRYPTION_KEYS=
CTRADER_ACTIVE_KEY_VERSION=
SCHEDULER_ENABLED=false
