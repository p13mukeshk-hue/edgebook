# Copy to /etc/edgebook/backup.env and chmod 0600.
COMPOSE_PROJECT_DIR=/opt/edgebook/current
COMPOSE_FILE=/opt/edgebook/current/deploy/vps/docker-compose.yml
COMPOSE_ENV_FILE=/etc/edgebook/edgebook.env
POSTGRES_SERVICE=postgres
POSTGRES_DB=edgebook
POSTGRES_BACKUP_USER=postgres
EDGEBOOK_DB_OWNER=edgebook_owner
UPLOAD_ROOT=/srv/edgebook-data/uploads
BACKUP_ROOT=/var/backups/edgebook
EDGEBOOK_QUIESCE_WRITERS=true

# Optional off-host tooling should consume only completed directories. This
# script intentionally performs no retention deletion.
