# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3210
LOG_LEVEL=info
TRUST_PROXY=false
PUBLIC_ORIGIN=http://localhost:8787

# PostgreSQL
DATABASE_URL=postgresql://edgebook_app:change-me@127.0.0.1:5432/edgebook
DB_POOL_MAX=10

# Google Identity Services. This client ID is public and is also returned by GET /api/config.
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Generate at least 32 random bytes. Never commit the real value.
# Example: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_PEPPER=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=14
SESSION_IDLE_MINUTES=1440
COOKIE_SECURE=false

# Private screenshot storage. Must be an absolute path outside the public web root.
UPLOAD_ROOT=/tmp/edgebook-uploads
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=40000000
USER_STORAGE_QUOTA_BYTES=262144000
TOTAL_STORAGE_QUOTA_BYTES=10737418240
MIN_DISK_FREE_BYTES=1073741824

# Server-sent events
SSE_HEARTBEAT_MS=20000

# Official cTrader Open API (optional as a complete group). The OAuth grant is
# fixed to view-only `accounts`; no order/trading operation exists in the API.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=
# JSON map of version -> 32-byte base64url key. Generate a key with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CTRADER_ENCRYPTION_KEYS=
CTRADER_ACTIVE_KEY_VERSION=
CTRADER_OAUTH_STATE_TTL_SECONDS=300
CTRADER_GRANT_TTL_SECONDS=600
CTRADER_REQUEST_TIMEOUT_MS=15000
CTRADER_SYNC_INTERVAL_SECONDS=300
CTRADER_STALE_AFTER_SECONDS=900
CTRADER_SYNC_OVERLAP_SECONDS=300
# Optional earlier emergency lower bound; the account registration timestamp
# remains authoritative and this value can never shorten the imported history.
CTRADER_HISTORY_START_TIMESTAMP=
CTRADER_REFRESH_SKEW_SECONDS=300
CTRADER_MAX_DEALS_PER_REQUEST=1000
CTRADER_SYMBOL_CACHE_SECONDS=86400
CTRADER_TRADING_TIME_ZONE=Asia/Kolkata
# Opt-in compatibility for a copied cTrader Remote MCP configuration. The
# credential remains trading-capable even though Edgebook hard-codes read tools.
CTRADER_MCP_ENABLED=false
# Keep false until the previous Firebase scheduler is disabled at cutover.
SCHEDULER_ENABLED=false
