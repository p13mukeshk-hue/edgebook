# Copy this to .env and fill in real values — never commit .env to git

# ── Zerodha / Kite Connect ────────────────────────────────────────────────────
ZERODHA_API_SECRET=your_kite_api_secret_here
ZERODHA_ENCRYPTION_KEY=generate_with__node_-e_"console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── cTrader Open API (required for auto token-refresh) ────────────────────────
# Get these from https://openapi.ctrader.com → My Apps → your app credentials.
# Without these, auto-refresh is skipped and users must reconnect every ~30 days.
CTRADER_CLIENT_ID=your_ctrader_app_client_id
CTRADER_CLIENT_SECRET=your_ctrader_app_client_secret
